# RAG provider: local | openai | ollama (auto if unset)
# RAG_PROVIDER=local

# Local mode (default when no API key): hashed embeddings + extractive answers
LOCAL_EMBEDDING_DIM=384

# Optional OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional Ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# GitHub token (or use: gh auth token)
GITHUB_TOKEN=
GH_TOKEN=

INCLUDE_MEGA_SNAPSHOT=false
GITHUB_OWNER=fitzyracing1
TOP_K=8
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
DATA_DIR=./data
